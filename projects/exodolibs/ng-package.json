{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/exodolibs",
  "assets": [
    {
      "input": "src/lib/assets",
      "glob": "**/*",
      "output": "assets"
    },
    {
      "input": "src/lib/assets",
      "glob": "**/*",
      "output": "lib/assets"
    },
    {
      "input": "src/lib",
      "glob": "style.scss",
      "output": "lib"
    },
    "LICENSE"
  ],
  "lib": {
    "entryFile": "src/public-api.ts"
  }
}
